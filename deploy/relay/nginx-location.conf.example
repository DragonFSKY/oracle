# Place these directives inside the HTTPS server block for the Relay hostname.
client_max_body_size 600m;
client_body_timeout 86400s;

location / {
    proxy_pass http://127.0.0.1:19476;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_send_timeout 86400s;
    proxy_read_timeout 86400s;

    # Buffer each upload at the edge before forwarding it to Node. This avoids
    # slow or proxied client uploads holding an upstream request open.
    proxy_request_buffering on;

    # SSE producer waits must be streamed immediately and may stay idle between
    # heartbeat comments. Do not cache, compress, or coalesce the event stream.
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    add_header X-Accel-Buffering no always;
}
